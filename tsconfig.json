{
  "compilerOptions": {
    "outDir": "./dist",
    // "rootDir": "./src",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "types": [
      "node",
      "vitest/globals"
    ],
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "api/**/*",
    "tests/**/*",
    "vitest.config.ts",
    // "prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    // "prisma.config.ts"
  ]
}