model Payment {
  id             String        @id @default(uuid())
  bookingId      String
  tranId         String        @unique // SSLCommerz transaction id, generated server-side
  valId          String?               // set after gateway success, used for server-side validation
  amount         Decimal       @db.Decimal(10, 2) // = booking.totalPrice at session creation
  currency       String        @default("BDT")
  status         PaymentStatus @default(INITIATED)
  gatewayPageUrl String?
  sslSessionKey  String?
  cardType       String?
  bankTranId     String?
  paidAt         DateTime?
  refundRefId         String?   // SSLCommerz refund reference (set when a refund is initiated)
  refundInitiatedAt   DateTime? // set when a refund attempt starts/fails (for later retry)
  refundCompletedAt   DateTime? // set only when the gateway confirms the refund succeeded

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId])
  @@index([status])
  @@map("payments")
}