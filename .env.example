PORT=4000

NODE_ENV=development

FRONTEND_URL_DEV=http://localhost:3000
FRONTEND_URL_PROD=https://your-app.vercel.app

DATABASE_URL="postgres://user:password@localhost:5432/tripverse?sslmode=require"

BCRYPT_SALT_ROUNDS=10

# Optional — admin account seeded by Step 13 (falls back to demo-admin@tripverse.com / demo123)
ADMIN_EMAIL=
ADMIN_PASSWORD=

JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# ── SSLCommerz (Step 16) — sandbox store creds until go-live ──
# Set SSL_COMMERZ_SANDBOX=false only when switching to live store creds.
SSL_COMMERZ_STORE_ID=
SSL_COMMERZ_STORE_PASSWORD=
SSL_COMMERZ_SANDBOX=true
# Publicly reachable base URL for the SSLCommerz callback/IPN URLs.
# Must NOT be localhost in sandbox - the gateway POSTs to these server-to-server.
BACKEND_PUBLIC_URL=http://localhost:4000
# Optional - refund API base URL (defaults to the sandbox/live merchantTransID endpoint)

# ── Optional (Zod .optional(); app boots without them) ──
# Used by Step 4 (Google OAuth) — required only when /auth/google is hit
GOOGLE_CLIENT_ID=
# Used by Step 6 (best-effort contact emails via Resend)
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=
EMAIL_FROM=
# Used by Step 21 (email verification + password reset — Redis OTP store + Nodemailer)
# Redis (node-redis) — the auth endpoints return 503 "not configured" when absent
REDIS_USER=
REDIS_PASSWORD=
REDIS_HOST=
REDIS_PORT=
# Nodemailer (Gmail app-password SMTP) — auth emails become best-effort no-ops when absent
SMTP_USER=
SMTP_PASSWORD=
